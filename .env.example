# Local development (SQLite). Production / staging: Supabase Postgres — see docs/POSTGRES-STAGING.md
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
# Local callbacks while developing:
# AUTH_URL=http://localhost:3000
# Production / staging site (OG, absolute URLs):
NEXT_PUBLIC_SITE_URL="https://www.tgetradecoltd.com"

# Seeded admin (change password in any shared environment)
SEED_ADMIN_EMAIL="sales@tgetradecoltd.com"
SEED_ADMIN_PASSWORD="ChangeMeAdmin123!"

# Transactional email (Resend). Without RESEND_API_KEY, forms still persist and email is logged.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="TG EXPLORET TRADE CO.,LTD <sales@tgetradecoltd.com>"
# SALES_INBOX_EMAIL=sales@tgetradecoltd.com
# Domain tgetradecoltd.com must be verified in Resend before from-address works.

# Supabase Storage (ACR-001) — product image uploads. See docs/SUPABASE-STORAGE.md
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET="product-images"
