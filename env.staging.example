# env.staging.example — set these in Vercel (Preview/Staging)

# Never commit real values. Copy to Vercel Environment UI.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://YOUR-STAGING.vercel.app"
NEXT_PUBLIC_SITE_URL="https://YOUR-STAGING.vercel.app"

# Optional
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="TG EXPLORET TRADE CO.,LTD <sales@tgetradecoltd.com>"
# SALES_INBOX_EMAIL=sales@tgetradecoltd.com

# Supabase Storage (required for admin image upload) — ACR-001
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# One-time seed only — remove after rotating password
# SEED_ADMIN_EMAIL=sales@tgetradecoltd.com
# SEED_ADMIN_PASSWORD=

# Production cutover (not staging):
# AUTH_URL="https://www.tgetradecoltd.com"
# NEXT_PUBLIC_SITE_URL="https://www.tgetradecoltd.com"
