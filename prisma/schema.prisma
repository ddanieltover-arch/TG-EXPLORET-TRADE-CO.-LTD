// LOCAL DEV: SQLite. Production (frozen architecture): PostgreSQL via Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  NEW
  IN_PROGRESS
  AWAITING_INFO
  QUOTED
  CLOSED
  SPAM
  ARCHIVED
}

enum Incoterm {
  FOB
  CIF
  EXW
  CNF
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
  SPAM
  ARCHIVED
}

enum InquirySource {
  INQUIRY
  CONTACT
  AI_ESCALATION
}

enum ApplicationStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  SPAM
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SALES_MANAGER
  READ_ONLY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String                 @id @default(cuid())
  categoryId       String
  slug             String                 @unique
  name             String
  shortDescription String?
  description      String?
  originCountry    String                 @default("Thailand")
  status           PublishStatus          @default(DRAFT)
  publishedAt      DateTime?
  category         Category               @relation(fields: [categoryId], references: [id])
  specifications   ProductSpecification[]
  packaging        ProductPackaging[]
  images           ProductImage[]
  quoteRequests    QuoteRequest[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  label     String
  value     String
  unit      String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
}

model ProductPackaging {
  id        String  @id @default(cuid())
  productId String
  name      String
  sizeLabel String?
  notes     String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  publicId  String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model QuoteRequest {
  id            String      @id @default(cuid())
  referenceCode String      @unique
  companyName   String
  contactName   String
  email         String
  phone         String?
  country       String
  productId     String?
  productLabel  String?
  quantityText  String
  destination   String
  incoterm      Incoterm?
  targetDate    DateTime?
  message       String?
  status        QuoteStatus @default(NEW)
  version       Int         @default(1)
  product       Product?    @relation(fields: [productId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Inquiry {
  id          String        @id @default(cuid())
  companyName String?
  contactName String
  email       String
  phone       String?
  country     String?
  message     String
  source      InquirySource @default(CONTACT)
  sourcePath  String?
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model DealerApplication {
  id            String            @id @default(cuid())
  companyName   String
  contactName   String
  email         String
  phone         String?
  country       String
  marketsServed String?
  message       String?
  status        ApplicationStatus @default(NEW)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}

model DistributorApplication {
  id            String            @id @default(cuid())
  companyName   String
  contactName   String
  email         String
  phone         String?
  country       String
  marketsServed String?
  message       String?
  status        ApplicationStatus @default(NEW)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}

model Certification {
  id          String        @id @default(cuid())
  name        String
  issuer      String?
  summary     String?
  documentUrl String?
  sortOrder   Int           @default(0)
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model SitePage {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  body      String
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
